<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Request | Roadside Assist</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <main class="page-shell">
    <form class="form-card" method="post" action="/requests">
      <p class="eyebrow">We'll take it from here</p>
      <h1>Create a request</h1>
      <p class="form-card__intro">Tell us what happened and where you are. Help is on the way.</p>
      <label for="description">description</label>
      <input id="description" name="description" type="text" />

      <label for="location">location</label>
      <input id="location" name="location" type="text" />

      <label for="status">status</label>
      <input id="status" name="status" type="text" />
      
      <label for="problem">What happened?</label>
      <select required name="problem" id="problem">
        <option value="">Choose Problem</option>
        <option value="fuel">fuel</option>
        <option value="flat wheels">flat wheels</option>
        <option value="battery">battery</option>
        <option value=""></option>
      </select>
      <label for="car">Which Car?</label>
      <select required name="car" id="car">
        <option value="">Choose Car</option>

        <% for(let oneCar of cars){ %>
            <option value="<%= oneCar._id %>"><%= oneCar.name %>"</option>
        <% } %>
       
      </select>

      <button>Create</button>
    </form>
    </main>
   
  </body>
</html>
