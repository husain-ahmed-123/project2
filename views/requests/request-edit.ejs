<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Request | Roadside Assist</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <main class="page-shell">
     <form class="form-card" method="post" action="/requests/<%=request._id%>?_method=PUT">
      <p class="eyebrow">Keep us in the loop</p>
      <h1>Edit request</h1>
      <p class="form-card__intro">Update the details so we can give you the right support.</p>
      <label for="description">description</label>
      <input value="<%= request.description%>" id="description" name="description" type="text" />

      <label for="location">location</label>
      <input value="<%= request.location%>" id="location" name="location" type="text" />

      <label for="status">status</label>
      <input value="<%= request.status%>"id="status" name="status" type="text" />
      
      <label for="problem">What happened?</label>
      <select required name="problem" id="problem">
        <option value="">Choose Problem</option>
        <option value="fuel">fuel</option>
        <option value="flat wheels">flat wheels</option>
        <option value="battery">battery</option>
        <option value=""></option>
      </select>
      <label for="car">Which Car?</label>
      <select required name="car" id="car">
        <option value="">Choose Car</option>

        <% for(let oneCar of cars){ %>
            <option value="<%= oneCar._id %>"><%= oneCar.name %>"</option>
        <% } %>
       
      </select>

      <button>Save changes</button>
    </form>
    </main>
  </body>
</html>
