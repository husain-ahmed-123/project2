<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reviews</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <h1>Reviews</h1>
    <% review.forEach(r => { %>
      <article class="review-card">
        <h2><%= r.text %></h2>
        <p><%= r.stars %> / 5 stars</p>
      </article>
    <% }) %>
  </body>
</html>
