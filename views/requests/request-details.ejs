<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Request Details | Roadside Assist</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    
    <main class="page-shell">
      <header class="page-heading">
        <div>
          <p class="eyebrow">We’re on it</p>
          <h1>Request details</h1>
        </div>
        <a href="/requests">Back to my requests</a>
      </header>
      <section class="detail-card">
        <p class="eyebrow">Your roadside request</p>
        <p class="detail-card__description"><%= request.description %></p>
      </section>

      <section aria-labelledby="reviews-heading">
        <div class="page-heading">
          <div>
            <p class="eyebrow">Kind words from the road</p>
            <h2 id="reviews-heading">Reviews</h2>
          </div>
        </div>
        <% if (reviews.length) { %>
          <div class="review-grid">
            <% let star = '⭐' %>
            <% for(let oneReview of reviews) { %>
              <article class="review-card">
                <h2><%= oneReview.text %></h2>
                <p class="review-stars"><%= star.repeat(Number(oneReview.stars)) %></p>
                <p>by: <%= oneReview.request.owner.email %></p>
              </article>
            <% } %>
          </div>
        <% } else { %>
          <p class="muted-copy">No reviews yet. Yours could be the first.</p>
        <% } %>
      </section>

      <form class="form-card review-form" action="/reviews/<%= request._id %>" method="post">
        <h2>Leave a review</h2>
        <label for="stars">Your rating</label>
        <select name="stars" id="stars">
          <option value="1">⭐</option>
          <option value="2">⭐⭐</option>
          <option value="3">⭐⭐⭐</option>
          <option value="4">⭐⭐⭐⭐</option>
          <option value="5">⭐⭐⭐⭐⭐</option>
        </select>
        <label for="text">Your review</label>
        <textarea name="text" id="text"></textarea>
        <button type="submit">Create review</button>
      </form>
    </main>
  </body>
</html>
