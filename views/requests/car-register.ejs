<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register Car | Roadside Assist</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <main class="page-shell">
    <form class="form-card" action="/cars" method="post">
      <p class="eyebrow">A smoother rescue starts here</p>
      <h1>Register your car</h1>
      <p class="form-card__intro">Add your vehicle details for a faster request next time.</p>
      <label for="name">name:</label>
      <input name="name" id="name" type="text" />

      <label for="model">car model</label>
      <input name="model" id="model" type="text" />
         <label for="plateNumber">plate number</label>
      <input name="plateNumber" id="plateNumber" type="number" />
        <label for="year">year</label>
      <input name="year" id="year" type="number" />
      
      <button>register car</button>
    </form>
    </main>
  </body>
</html>
